{
  "app": {
    // 签名配置不进版本库：里面含本地绝对路径与口令。
    // 装真机前请用 DevEco 的 File > Project Structure > Signing Configs 勾选自动签名，
    // IDE 会写回 signingConfigs 段；提交前请跑 tools/check-before-publish.py 自查。
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        // API 26 起是纯版本号字符串；compileSdk 显式钉住，免得换 DevEco 版本时悄悄跳。
        "compileSdkVersion": "26.0.0",
        "targetSdkVersion": "26.0.0",
        // 兼容下限故意留在 5.0.0(12)：2in1 用户里还有一批 HarmonyOS 5 的机器，
        // 用到 12 之后新增的 API 时用 deviceInfo.sdkApiVersion 守卫（见 docs/technical-notes.md §10）。
        "compatibleSdkVersion": "5.0.0(12)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
