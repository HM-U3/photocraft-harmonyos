+/// Most frames an animated GIF is imported with; past this only the first frame is kept.
+pub const GIF_MAX_FRAMES: usize = 200;
+/// Most pixels one imported GIF may hold across all of its frames. Frames are RGBA8 (4 bytes per
+/// pixel) and stored as tiles, so 32 Mpx is 128 MB of pixels before empty tiles are pruned.
+const GIF_MAX_TOTAL_PIXELS: u64 = 32 << 20;
+
+/// Decodes an animated GIF into one layer per frame (`Frame 1` … `Frame N`).
+///
+/// Only the first frame starts out visible: the document then looks exactly like the still image
+/// the single-frame decoder produced, while the rest of the animation sits in the layers panel to
+/// be edited. Still GIFs and ones over [`GIF_MAX_FRAMES`] / [`GIF_MAX_TOTAL_PIXELS`] fall back to
+/// [`import_flat`], which keeps the first frame and reports the frames it left out.
+pub fn import_gif_frames(name: &str, bytes: &[u8]) -> Result<ImportResult, IoError> {
+    // A damaged or unusual animation is still worth opening as a still.
+    let Ok(frames) = codecs::decode_gif_frames(bytes) else { return import_flat(name, bytes) };
+    let n = frames.len();
+    if n <= 1 {
+        return import_flat(name, bytes);
+    }
+    let (w, h) = frames.images[0].dimensions();
+    let pixels = u64::from(w) * u64::from(h) * n as u64;
+    if n > GIF_MAX_FRAMES || pixels > GIF_MAX_TOTAL_PIXELS {
+        let mut r = import_flat(name, bytes)?;
+        r.warnings.push(format!(
+            "the animation's {n} frames hold {pixels} pixels in total, over the {GIF_MAX_TOTAL_PIXELS} budget for importing frames as layers"
+        ));
+        return Ok(r);
+    }
+    let mode = ColorMode::Rgb;
+    let depth = SampleType::U8;
+    let mut doc = Document::new(name, Size::new(w, h), mode, depth);
+    let fmt = PixelFormat::new(mode, depth, true);
+    for (i, img) in frames.images.iter().enumerate() {
+        let mut s = Surface::new(fmt);
+        s.write_interleaved(Rect::new(0, 0, w as i32, h as i32), img.data());
+        s.prune();
+        let mut layer = Layer::new(format!("Frame {}", i + 1), LayerContent::Raster(s));
+        // Every frame visible at once would composite the whole animation into one still.
+        layer.visible = i == 0;
+        doc.layers.push(layer);
+    }
+    doc.icc_profile = frames.images[0].icc.clone().map(Arc::new);
+    doc.metadata.exif = frames.images[0].meta.exif.clone().map(Arc::new);
+    let secs = frames.duration_ms() as f64 / 1000.0;
+    Ok(ImportResult {
+        document: doc,
+        warnings: vec![format!(
+            "imported all {n} frames of the GIF as layers Frame 1..{n} ({secs:.2}s per loop); only Frame 1 is visible, switch layers to see the others"
+        )],
+    })
+}
