+/// Every frame of an animated GIF, composited the way a viewer draws them.
+///
+/// `image`'s GIF reader applies each frame's disposal method over the previous one, so each
+/// entry here is a full-canvas RGBA8 image rather than the file's partial, delta-encoded one.
+pub(crate) fn decode_gif_frames(bytes: &[u8], limits: &Limits) -> Result<GifFrames, CodecError> {
+    // Two passes over the header: the animation reader owns the reader it is built from, so the
+    // colour profile and EXIF (which live in the same header blocks) are read separately.
+    let mut head = image::ImageReader::with_format(Cursor::new(bytes), image::ImageFormat::Gif);
+    let mut hl = image::Limits::default();
+    hl.max_image_width = Some(limits.max_width);
+    hl.max_image_height = Some(limits.max_height);
+    hl.max_alloc = Some(limits.max_alloc);
+    head.limits(hl);
+    let mut hd = head.into_decoder().map_err(|e| map_err(Format::Gif, e))?;
+    let (w, h) = hd.dimensions();
+    limits.check_bytes(w, h, ChannelLayout::Rgba.channels() as u64)?;
+    let mut icc = hd.icc_profile().ok().flatten();
+    let mut exif = hd.exif_metadata().ok().flatten();
+
+    let dec = image::codecs::gif::GifDecoder::new(Cursor::new(bytes)).map_err(|e| map_err(Format::Gif, e))?;
+    let mut images = Vec::new();
+    let mut delays_ms = Vec::new();
+    for frame in dec.into_frames() {
+        let frame = frame.map_err(|e| map_err(Format::Gif, e))?;
+        let (num, denom) = frame.delay().numer_denom_ms();
+        // GIF stores tenths of a millisecond; a 0 delay means "as fast as the viewer allows".
+        delays_ms.push((num / denom.max(1)).max(10));
+        let (fw, fh) = (frame.buffer().width(), frame.buffer().height());
+        if (fw, fh) != (w, h) {
+            return Err(CodecError::InvalidImage(format!("frame {fw}x{fh} does not match the canvas {w}x{h}")));
+        }
+        let mut img = Image::from_raw(fw, fh, ChannelLayout::Rgba, SampleType::U8, frame.into_buffer().into_raw())?;
+        if images.is_empty() {
+            // The profile and EXIF belong to the file, not to a frame: keep them on the first one.
+            img = img.with_icc(icc.take()).with_meta(crate::Metadata { exif: exif.take(), xmp: None, dpi: None, text: Vec::new() });
+        }
+        images.push(img);
+    }
+    if images.is_empty() {
+        return Err(CodecError::InvalidImage("the GIF holds no frames".into()));
+    }
+    Ok(GifFrames { images, delays_ms })
+}
