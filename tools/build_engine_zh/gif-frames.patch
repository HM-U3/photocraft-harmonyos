+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A 1x1 GIF89a holding `n` frames (as `apps/photocraft-cli/tests/cli.rs` builds one).
+    fn tiny_gif(n: usize) -> Vec<u8> {
+        let mut gif = b"GIF89a\x01\0\x01\0\x80\0\0\0\0\0\xFF\xFF\xFF".to_vec();
+        for _ in 0..n {
+            gif.extend_from_slice(b"\x2C\0\0\0\0\x01\0\x01\0\0\x02\x02\x44\x01\0");
+        }
+        gif.push(0x3B);
+        gif
+    }
+
+    #[test]
+    fn animated_gif_becomes_one_layer_per_frame() {
+        let r = import_gif_frames("anim.gif", &tiny_gif(3)).unwrap();
+        let d = &r.document;
+        assert_eq!(d.layers.len(), 3, "warnings: {:?}", r.warnings);
+        assert_eq!(d.layers[0].name, "Frame 1");
+        assert_eq!(d.layers[2].name, "Frame 3");
+        // Only the first frame shows, or every frame would composite into one still.
+        assert!(d.layers[0].visible);
+        assert!(!d.layers[1].visible);
+        assert!(!d.layers[2].visible);
+        assert_eq!((d.size.width, d.size.height), (1, 1));
+        assert!(r.warnings.iter().any(|w| w.contains("3 frames")), "warnings: {:?}", r.warnings);
+    }
+
+    #[test]
+    fn still_gif_keeps_the_single_background_layer() {
+        let r = import_gif_frames("still.gif", &tiny_gif(1)).unwrap();
+        assert_eq!(r.document.layers.len(), 1);
+        assert_eq!(r.document.layers[0].name, "Background");
+    }
+
+    #[test]
+    fn a_damaged_animation_still_opens_as_a_still() {
+        let mut gif = tiny_gif(3);
+        gif.truncate(gif.len() - 6);
+        let r = import_gif_frames("broken.gif", &gif).unwrap();
+        assert_eq!(r.document.layers.len(), 1, "warnings: {:?}", r.warnings);
+    }
+}
