+/// Every frame of an animated GIF, in order, with how long each one is shown.
+///
+/// Unlike [`decode`], which keeps the first frame only, this walks the whole animation. Each
+/// frame is a full-canvas RGBA8 image: the reader applies the file's disposal methods, so what
+/// comes back is what a viewer would draw, not the partial frames the file stores.
+#[derive(Debug, Clone)]
+pub struct GifFrames {
+    /// Composited frames, `len() >= 1`, all the same size.
+    pub images: Vec<Image>,
+    /// Display time of each frame in milliseconds, parallel to [`GifFrames::images`].
+    pub delays_ms: Vec<u32>,
+}
+
+impl GifFrames {
+    /// Number of frames.
+    pub fn len(&self) -> usize {
+        self.images.len()
+    }
+
+    /// `true` for a single-frame GIF (not an animation).
+    pub fn is_empty(&self) -> bool {
+        self.images.is_empty()
+    }
+
+    /// Total running time of one loop, in milliseconds.
+    pub fn duration_ms(&self) -> u64 {
+        self.delays_ms.iter().map(|&d| u64::from(d)).sum()
+    }
+}
+
+/// Decodes an animated GIF with default [`Limits`].
+pub fn decode_gif_frames(bytes: &[u8]) -> Result<GifFrames, CodecError> {
+    decode_gif_frames_with(bytes, &DecodeOptions::default())
+}
+
+/// Decodes an animated GIF. Fails with [`CodecError::UnknownFormat`] when `bytes` is not a GIF.
+pub fn decode_gif_frames_with(bytes: &[u8], opts: &DecodeOptions) -> Result<GifFrames, CodecError> {
+    via_image::decode_gif_frames(bytes, &opts.limits)
+}
