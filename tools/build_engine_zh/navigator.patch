+/// The pixel size of the Navigator's reduction of `doc` (longer side [`NAVIGATOR_SIDE`]; the
+/// document is never enlarged). Matches what [`photocraft_compose::thumbnail_buffer`] produces, so
+/// a damage patch lands on the pixels it names.
+fn navigator_size(doc: &Document) -> [u32; 2] {
+    let b = doc.bounds();
+    let longest = b.width().max(b.height()).max(1);
+    let scale = (NAVIGATOR_SIDE as f32 / longest as f32).min(1.0);
+    [((b.width() as f32 * scale).round() as u32).max(1), ((b.height() as f32 * scale).round() as u32).max(1)]
+}
