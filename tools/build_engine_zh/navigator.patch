+    /// The Navigator patches its image in place with [`photocraft_compose::render_reduced_damage`],
+    /// which names output pixels of the reduction `navigator_size` is supposed to describe. If the
+    /// two ever disagree the patch lands on the wrong pixels, so hold them together here.
+    #[test]
+    fn navigator_size_describes_the_reduction_it_patches() {
+        for (w, h) in [(8_u32, 8_u32), (3120, 2080), (400, 4000), (1, 700), (4096, 4096)] {
+            let mut s = photocraft_engine::Session::new();
+            s.execute("file.new", serde_json::json!({"width": w, "height": h, "name": "N"})).unwrap();
+            let doc = s.active().unwrap().doc.clone();
+            let [nw, nh] = navigator_size(&doc);
+            let reduced = photocraft_compose::thumbnail_buffer(&doc, NAVIGATOR_SIDE).rect;
+            assert_eq!([reduced.width(), reduced.height()], [nw, nh], "{w}×{h}");
+            assert!(nw.max(nh) <= NAVIGATOR_SIDE && nw >= 1 && nh >= 1, "{w}×{h} → {nw}×{nh}");
+        }
+    }
